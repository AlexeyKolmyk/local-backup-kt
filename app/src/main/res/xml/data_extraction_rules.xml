<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for API 31+.
   Local backup copies can be large; keep them out of cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
